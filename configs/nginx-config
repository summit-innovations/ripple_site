server {

        root /srv/projects/ripple_site/module/summit-innovative/html;
        index index.html index.htm index.nginx-debian.html;

        server_name summit-innovative.duckdns.org www.summit-innovative.duckdns.org;

        location / {
                try_files $uri $uri/ =404;
        }

    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/summit-innovative.duckdns.org/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/summit-innovative.duckdns.org/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
client_max_body_size 20M;
location /upload/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

}
server {
    if ($host = www.summit-innovative.duckdns.org) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    if ($host = summit-innovative.duckdns.org) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


        listen 80;
        listen [::]:80;

        server_name summit-innovative.duckdns.org www.summit-innovative.duckdns.org;
    return 404; # managed by Certbot




}
